# =============================================================================
# LookSi — Variables de entorno
# LOOKSI-028
# =============================================================================
#
# Copiar este archivo como .env.local y completar los valores:
#   cp .env.example .env.local
#
# NUNCA commitear .env.local — está en .gitignore.
# Configurar estas variables también en:
#   - Vercel: Settings → Environment Variables (Production + Preview)
#   - GitHub: Settings → Secrets → Actions (NEXT_PUBLIC_* para el job de build)
# =============================================================================


# ── Supabase (https://app.supabase.com → Project Settings → API) ─────────────

# URL pública del proyecto (segura para el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key pública — RLS protege los datos, esta key es segura para el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role key — SOLO API Routes server-side. NUNCA con prefijo NEXT_PUBLIC_.
# Con esta key se bypasea RLS: usar únicamente donde sea estrictamente necesario.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...


# ── Google Gemini (https://aistudio.google.com/app/apikey) ───────────────────
# SOLO server-side en API Routes — NUNCA exponer al cliente.
# Modelo: gemini-2.5-flash-lite
GEMINI_API_KEY=AIza...


# ── Sentry (https://sentry.io → Project Settings → Client Keys / DSN) ────────
# NEXT_PUBLIC_SENTRY_DSN: usado por el SDK del cliente (browser)
# SENTRY_DSN: mismo valor, usado por el SDK del servidor (Node.js)
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/...
SENTRY_DSN=https://...@o0.ingest.sentry.io/...
# Auth token para subir source maps en CI/CD (no necesario en .env.local)
SENTRY_AUTH_TOKEN=sntrys_...


# ── PostHog (https://app.posthog.com → Project Settings → Project API Key) ───
# NEXT_PUBLIC_POSTHOG_KEY no es un secret crítico (se embebe en el bundle)
# Usar EU cloud (https://eu.i.posthog.com) si aplica GDPR
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
