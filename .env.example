# ==============================================================================
# LookSi — Variables de entorno
# Copiar este archivo como .env.local y completar los valores
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (https://app.supabase.com → Project Settings → API)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...  # anon / public key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...      # service_role key — NUNCA NEXT_PUBLIC_

# ------------------------------------------------------------------------------
# Gemini AI (https://aistudio.google.com/apikey)
# SOLO usar en API Routes server-side — NUNCA con NEXT_PUBLIC_
# Modelo: gemini-2.5-flash-lite
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIza...

# ------------------------------------------------------------------------------
# Sentry (https://sentry.io → Project Settings → Client Keys / DSN)
# El mismo DSN se usa para cliente y servidor con distintos prefijos
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...  # Para source maps en CI/CD

# ------------------------------------------------------------------------------
# Posthog (https://app.posthog.com → Project Settings → Project API Key)
# NEXT_PUBLIC_POSTHOG_KEY es el Project API Key (no es un secret crítico)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
