{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Percha — Tu guardarropa, digital",
  "short_name": "Percha",
  "description": "Digitalizá tu ropa, analizá prendas con IA y armá looks pensados para hoy.",
  "lang": "es-AR",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f7f5ef",
  "theme_color": "#f7f5ef",
  "categories": ["lifestyle", "shopping", "utilities"],
  "icons": [
    {
      "src": "/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/wardrobe-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Guardarropa"
    },
    {
      "src": "/screenshots/generator-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Generador de looks"
    }
  ],
  "shortcuts": [
    {
      "name": "Agregar prenda",
      "short_name": "Agregar",
      "description": "Capturar foto y analizar con IA",
      "url": "/agregar",
      "icons": [{ "src": "/icons/shortcut-add.png", "sizes": "96x96" }]
    },
    {
      "name": "Generar look",
      "short_name": "Generar",
      "description": "Armar un nuevo look",
      "url": "/generador",
      "icons": [{ "src": "/icons/shortcut-generate.png", "sizes": "96x96" }]
    }
  ]
}
